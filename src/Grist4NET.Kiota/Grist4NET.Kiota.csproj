<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Grist4NET.Kiota</PackageId>
		<Version>1.0.1</Version>
		<Title>Grist4NET.Kiota</Title>
		<Authors>djsime1</Authors>
		<Description>
			Kiota-generated API client from Grist's OpenAPI spec.
		</Description>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>

	<Target
		Name="CreateKiotaClient"
		BeforeTargets="Rebuild"
		Condition="'$(Configuration)' == 'Debug'"
	>
		<Exec Command="dotnet tool restore" WorkingDirectory="$(ProjectDir)" />
		<Exec Command="dotnet kiota update -o Client" WorkingDirectory="$(ProjectDir)" />
	</Target>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<AssemblyTitle>$(Title)</AssemblyTitle>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<Copyright>$(Authors)</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.0" />
	</ItemGroup>
</Project>
